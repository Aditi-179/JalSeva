PORT=5000
NODE_ENV=development

# Database configuration (MySQL / Amazon RDS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aquaalert_db
DB_SSL=false

# Admin Authentication
JWT_SECRET=aquaalert_jwt_secret_change_in_production_key_9921
JWT_EXPIRES_IN=24h
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@aquaalert.gov
INITIAL_ADMIN_PASSWORD=Admin@123

# Amazon S3 Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=aquaalert-incident-photos-bucket
USE_LOCAL_STORAGE=true
UPLOAD_DIR=uploads

# Amazon SNS Configuration
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:AquaAlert-Incidents-Topic
ENABLE_SNS_NOTIFICATIONS=false

# AWS SSM Parameter Store (for production on EC2)
USE_SSM_PARAMETER_STORE=false
SSM_DB_PASSWORD_PATH=/aquaalert/prod/db/password
SSM_JWT_SECRET_PATH=/aquaalert/prod/jwt/secret

