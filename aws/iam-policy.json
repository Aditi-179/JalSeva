{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AquaAlertS3BucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::aquaalert-incident-photos/*"
    },
    {
      "Sid": "AquaAlertS3BucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::aquaalert-incident-photos"
    },
    {
      "Sid": "AquaAlertSSMParameterAccess",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:*:*:parameter/aquaalert/*"
    },
    {
      "Sid": "AquaAlertSNSPublish",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:*:*:AquaAlert-Incidents-Topic"
    },
    {
      "Sid": "AquaAlertCloudWatchLoggingAndMetrics",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams",
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*"
    }
  ]
}

